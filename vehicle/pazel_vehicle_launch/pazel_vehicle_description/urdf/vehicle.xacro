<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- load parameter -->
  <xacro:property name="vehicle_info" value="${xacro.load_yaml('$(find pazel_vehicle_description)/config/vehicle_info.param.yaml')}"/>
  
  <material name="Black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="Green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="Grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="Red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  
  <material name="Blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  
  <!-- vehicle body -->
  <link name="base_link">
  <visual>
    <origin xyz="-0.161 0.22373 0.1" rpy=" 0 0 ${pi/2.0}"/>
    <geometry>
      <mesh filename="package://pazel_vehicle_description/mesh/base_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="Green"/>
  </visual>
  
  </link>
</robot>
