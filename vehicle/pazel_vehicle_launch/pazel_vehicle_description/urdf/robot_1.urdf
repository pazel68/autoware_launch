<?xml version="1.0"?>
<robot name="amr_prototype">

  <material name="Black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="Green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="Grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="Red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  
  <link name="base_footprint"/>

  <link name="base_link">
  
  <visual>
    <origin xyz="-0.075 -0.090 0.022" rpy="1.5708 0 1.5708"/>
    <geometry>
      <mesh filename="package://robot_pkg/meshes/robot_1/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="Grey"/>
  </visual>
  
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.125" rpy="0 0 0"/>
  </joint>
  
  <link name="base_scan">
  
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://robot_pkg/meshes/robot_1/LIDAR.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="Black"/>
  </visual>
  
  </link>
  <joint name="base_link_to_base_scan" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0.440 -0.220 0.7335" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry>
      <mesh filename="package://robot_pkg/meshes/robot_1/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
      <material name="Red"/>
    </visual>
  </link>
  
  <link name="imu_link">
    <visual>
      <geometry>
      <mesh filename="package://robot_pkg/meshes/robot_1/IMU.stl" scale="0.001 0.001 0.001"/>
    </geometry>
      <material name="Red"/>
    </visual>
  </link>
  
  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.153 -0.150 0.145" rpy="0 0 0"/>
  </joint>
  
  <!--link name="cam_link">
    <visual>
      <geometry>
      <mesh filename="package://robot_pkg/meshes/robot_1/cam.stl" scale="0.001 0.001 0.001"/>
    </geometry>
      <material name="Red"/>
    </visual>
  </link>

  <joint name="base_link_to_cam" type="fixed">
    <parent link="base_link"/>
    <child link="cam_link"/>
    <origin xyz="0.425 -0.220 0.82925" rpy="0 0 0"/>
  </joint-->
  
  <link name="left_wheel">
    <visual>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.03375"/>
      </geometry>
      <material name="Black"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.10785 -0.00025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.03375"/>
      </geometry>
      <material name="Black"/>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.10785 -0.00025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
